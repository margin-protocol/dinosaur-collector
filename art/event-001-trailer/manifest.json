  "music": "Original synthesized pentatonic string-like ambient score and paper/sword sound effects; no third-party recordings, no voice-over.",
  "artTreatment": "Existing official illustrations are composited with pans/fades and vector ink, fog, petals, ribbons, and sword strokes. This is a motion-graphics trailer, not newly generated character animation.",
  "storyboard": [
    {
      "start": 0,
      "end": 3,
      "title": "宣紙墨暈",
      "text": "一紙紅妝。一場出逃。／頁間居民 · EVENT 001"
    },
    {
      "start": 3,
      "end": 8,
      "title": "竹林花轎",
      "text": "我要嫁給誰？怎麼都沒有人問過我？"
    },
    {
      "start": 8,
      "end": 12,
      "title": "紙傀從霧中浮現",
      "text": "紙人的臉上，畫著一模一樣的笑。"
    },
    {
      "start": 12,
      "end": 17,
      "title": "墨色劍光・聞止水",
      "text": "站我後面。"
    },
    {
      "start": 17,
      "end": 22,
      "title": "十萬兩客棧",
      "text": "活捉，十萬兩／我好貴喔。"
    },
    {
      "start": 22,
      "end": 25,
      "title": "杜今朝",
      "text": "靖安司辦案。"
    },
    {
      "start": 25,
      "end": 28,
      "title": "徐汀云",
      "text": "你想知道什麼？價錢另議。"
    },
    {
      "start": 28,
      "end": 31,
      "title": "游未遲",
      "text": "這身衣裳，我見過三次。"
    },
    {
      "start": 31,
      "end": 34,
      "title": "林晏洄",
      "text": "說話慢，你別急。"
    },
    {
      "start": 34,
      "end": 37,
      "title": "程不言",
      "text": "一方不曾允諾，何來兩姓之好？"
    },
    {
      "start": 37,
      "end": 40,
      "title": "簡牧陽",
      "text": "有什麼壞掉的，交給我！"
    },
    {
      "start": 40,
      "end": 45,
      "title": "紅帖山莊・斷紅綢",
      "text": "她說了，不嫁。"
    },
    {
      "start": 45,
      "end": 50,
      "title": "正式主視覺",
      "text": "十萬兩紅妝／此生護卿"
    },
    {
      "start": 50,
      "end": 54,
      "title": "上下卷卡池",
      "text": "上卷11/26 12:00、下卷11/29 12:00"
    },
    {
      "start": 54,
      "end": 60,
      "title": "活動時間表",
      "text": "上卷 11/26 12:00｜下卷 11/29 12:00｜討伐至 12/10｜墨玉閣至 12/17／SSR 聞止水・海棠新娘小湘 登場"
    }
  ],
